# Bot token from the Discord Developer Portal (Bot page). Never commit a real token.
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information).
CLIENT_ID=

# Server ID. Guild slash commands are registered here and show up immediately.
GUILD_ID=

# Role granted when a member taps I agree on the rules message.
RULES_ROLE_ID=

# Staff role. Sees ticket channels and can manage emojis, stickers, and sounds.
STAFF_ROLE_ID=
